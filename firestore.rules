rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function myProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && hasProfile()
        && (
          myProfile().role == "admin"
          || myProfile().isAdmin == true
        )
        && (
          myProfile().status == "approved"
          || myProfile().isApproved == true
        )
        && !(myProfile().blocked == true)
        && !(myProfile().status in ["blocked", "blocked_review", "deleted"]);
    }

    function isApprovedMaster() {
      return signedIn()
        && hasProfile()
        && (
          myProfile().status == "approved"
          || myProfile().isApproved == true
          || myProfile().role == "admin"
        )
        && !(myProfile().blocked == true)
        && !(myProfile().status in ["blocked", "blocked_review", "deleted"]);
    }

    function allowCacheForSelf(uid) {
      return isSelf(uid)
        && isApprovedMaster()
        && !(
          myProfile().securityPolicy.allowLocalCache == false
          || myProfile().securityPolicy.allowReadData == false
          || myProfile().securityPolicy.allowLogin == false
        );
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ["master", "admin"]
        && request.resource.data.status in ["pending", "approved"];

      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["lastLoginAt", "updatedAt"]);

      allow update, delete: if isAdmin();
    }

    match /server_db/{itemId} {
      allow read: if isApprovedMaster()
        && !(myProfile().securityPolicy.allowReadData == false);

      allow create, update, delete: if isAdmin();
    }

    match /user_db/{uid}/items/{itemId} {
      allow read: if (allowCacheForSelf(uid) || isAdmin());
      allow create, update, delete: if (isSelf(uid) && isApprovedMaster()) || isAdmin();
    }

    match /app_meta/{docId} {
      allow read: if isApprovedMaster();
      allow create, update, delete: if isAdmin();
    }

    match /sync_versions/{docId} {
      allow read: if isApprovedMaster();
      allow create, update, delete: if isAdmin();
    }

    match /ai_accounts/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /ai_transactions/{transactionId} {
      allow read: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /ai_usage/{usageId} {
      allow read: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /ai_payment_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    match /security_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /device_integrity/{docId} {
      allow read: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /requests/{requestId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /logs/{logId} {
      allow create: if signedIn();
      allow read, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
