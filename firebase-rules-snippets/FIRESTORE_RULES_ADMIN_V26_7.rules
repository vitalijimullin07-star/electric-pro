rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == "vits0007@gmail.com";
    }

    function own(userId) {
      return signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /server_db/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /user_db/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow create, update, delete: if own(userId);
      match /{subCol}/{subDoc} {
        allow read: if own(userId);
        allow write: if own(userId);
      }
    }

    match /users/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow create, update: if own(userId);
      allow delete: if isAdmin();
      match /{subCol}/{subDoc} {
        allow read: if own(userId);
        allow write: if own(userId);
      }
    }

    match /user_profiles/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if own(userId);
    }

    match /profiles/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if own(userId);
    }

    match /masters/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if own(userId);
    }

    match /app_users/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if own(userId);
    }

    match /access/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /user_access/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /access_control/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /user_subscriptions/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /subscriptions/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /ai_balances/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /ai_wallets/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /token_balances/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /user_ai_balances/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /wallets/{userId} {
      allow get: if own(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /payment_requests/{requestId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /admin_logs/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
