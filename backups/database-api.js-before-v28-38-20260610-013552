(function(){function normalize(t){return String(t||"").toLowerCase().replaceAll("ё","е").replace(/[^a-zа-я0-9]+/gi," ").trim()}async function findCandidates({type,query,limit=20}={}){const key=type==="work"?"my_work_db":"my_material_db",items=await window.CacheAPI?.get?.(key)||[],words=normalize(query).split(" ").filter(w=>w.length>1);return items.filter(i=>!i.deleted).map(i=>({...i,score:words.reduce((s,w)=>s+(normalize([i.name,i.category,i.subcategory,i.brand,i.tags?.join(" ")].join(" ")).includes(w)?1:0),0)})).filter(i=>i.score>0).sort((a,b)=>b.score-a.score||(a.price||0)-(b.price||0)).slice(0,limit)}window.DatabaseAPI={findCandidates}})();
