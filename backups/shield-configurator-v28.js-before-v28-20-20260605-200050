        });
        return { key: g.key || ("m" + i), title: g.title || ("Группа " + (i + 1)), leak, prot, lines, apps: g.apps || [], phase: g.phase || "1", collapsed: true };
      }).filter(g => g.lines.length);
    } else {
      const pk = protKind();
