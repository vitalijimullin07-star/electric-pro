/* Shield Configurator V28.2 — стиль в духе приложения (тёмное стекло, зелёные акценты) */
#ep-shield-v28-root { display:block; }

.shv28 { display:flex; flex-direction:column; gap:12px; padding-bottom:24px; }

.shv28-card {
  background: rgba(248,250,252,.97);
  color:#0f172a;
  border-radius:18px;
  padding:14px;
  box-shadow:0 10px 28px rgba(0,0,0,.18);
}
.shv28-card h3 { margin:0 0 8px; font:900 16px/1.2 system-ui; letter-spacing:-.01em; }
.shv28-note { color:#64748b; font:700 12px/1.3 system-ui; margin-bottom:10px; }

/* шаблоны */
.shv28-tpl { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
.shv28-tpl-btn {
  border:1px solid rgba(15,23,42,.12); background:#fff; color:#0f172a;
  border-radius:12px; padding:11px 6px; font:800 13px/1.1 system-ui;
}
.shv28-tpl-btn.active { background:#dcfce7; border-color:#22c55e; color:#14532d; }

/* помещения */
.shv28-rooms { display:flex; flex-direction:column; gap:8px; }
.shv28-room { display:flex; align-items:center; gap:10px; }
.shv28-room-ic { font-size:18px; flex:0 0 auto; }
.shv28-room-lb { flex:1; min-width:0; font:800 14px/1.2 system-ui; }
.shv28-stepper { display:grid; grid-template-columns:34px 52px 34px; gap:6px; flex:0 0 auto; }
.shv28-stepper button {
  height:34px; border:0; border-radius:10px; background:#020617; color:#fff;
  font:900 18px/1 system-ui;
}
.shv28-stepper input {
  height:34px; width:100%; text-align:center; border:1px solid rgba(15,23,42,.14);
  border-radius:10px; background:rgba(226,232,240,.7); color:#0f172a;
  font:900 15px/1 system-ui; outline:none; -moz-appearance:textfield;
}
.shv28-stepper input::-webkit-outer-spin-button,
.shv28-stepper input::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
.shv28-stepper input:focus { background:#fff; border-color:#22c55e; }

/* отдельные линии */
.shv28-lines { display:flex; flex-direction:column; gap:7px; }
.shv28-line {
  display:flex; align-items:center; gap:10px; width:100%; text-align:left;
  border:1px solid rgba(15,23,42,.10); background:#fff; color:#0f172a;
  border-radius:12px; padding:11px 12px; font:800 14px/1.2 system-ui;
}
.shv28-line-lb { flex:1; min-width:0; }
.shv28-nom {
  flex:0 0 auto; background:rgba(226,232,240,.85); color:#334155;
  border-radius:999px; padding:2px 9px; font:900 12px/1.3 system-ui;
}
.shv28-tick { flex:0 0 18px; width:18px; text-align:center; color:#22c55e; font:900 16px/1 system-ui; }
.shv28-line.on { background:#dcfce7; border-color:#22c55e; }
.shv28-line.on .shv28-nom { background:#fff; color:#14532d; }

/* опции */
.shv28-opts { display:flex; flex-direction:column; gap:7px; }
.shv28-opt {
  display:flex; align-items:center; justify-content:space-between; gap:10px; width:100%;
  border:1px solid rgba(15,23,42,.10); background:#fff; color:#0f172a;
  border-radius:12px; padding:11px 12px; font:800 14px/1.2 system-ui; text-align:left;
}
.shv28-opt b { font:900 12px/1.3 system-ui; color:#94a3b8; }
.shv28-opt.on { background:#dcfce7; border-color:#22c55e; }
.shv28-opt.on b { color:#14532d; }

/* корпус */
.shv28-grid2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.shv28-grid2 label { display:flex; flex-direction:column; gap:5px; font:800 12px/1.2 system-ui; color:#475569; }
.shv28-grid2 select {
  height:40px; border:1px solid rgba(15,23,42,.14); border-radius:10px;
  background:#fff; color:#0f172a; font:800 14px/1 system-ui; padding:0 8px;
}
.shv28-sizemode {
  margin-top:10px; width:100%; display:flex; align-items:center; justify-content:space-between;
  border:1px solid rgba(15,23,42,.10); background:#fff; color:#0f172a;
  border-radius:12px; padding:11px 12px; font:800 13px/1.2 system-ui; text-align:left;
}
.shv28-sizemode b { font:900 12px/1.3 system-ui; color:#94a3b8; }
.shv28-sizemode.on { background:#dcfce7; border-color:#22c55e; }
.shv28-sizemode.on b { color:#14532d; }

/* сводка */
.shv28-summary {
  display:grid; grid-template-columns:repeat(3,1fr); gap:8px;
  background:rgba(2,20,21,.5); border:1px solid rgba(34,197,94,.25);
  border-radius:16px; padding:12px;
}
.shv28-summary div { display:flex; flex-direction:column; gap:3px; text-align:center; }
.shv28-summary span { color:#94a3b8; font:700 10px/1.2 system-ui; }
.shv28-summary b { color:#e2e8f0; font:900 16px/1 system-ui; }

/* кнопка далее */
.shv28-next {
  width:100%; border:0; border-radius:16px; padding:14px;
  background:linear-gradient(135deg,#16a34a,#22c55e); color:#fff;
  font:900 16px/1.1 system-ui; display:flex; flex-direction:column; align-items:center; gap:2px;
}
.shv28-next small { font:700 11px/1 system-ui; opacity:.85; }
