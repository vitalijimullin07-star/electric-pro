/* ============================================================
   Electric Pro — Cable helper V28
   Общий справочник кабеля: фиксированный список + кабели из БД,
   автоподстановка по номиналу автомата, и подбор цены по выбору.
   API: window.EPCableV28
     LIST            — фиксированный список типов
     defaultValueFor(nom) -> "fix:<тип>"  (C10->3х1.5 и т.д.)
     dbCables()      -> [{id,name,price}]  (из активной базы)
     all()           -> [{value,label,price}]  (для <select>: БД + список)
     resolveByValue(value) -> {label,name,price,found}
   ============================================================ */
(() => {
  "use strict";

  // фиксированный список (тип -> ключевые слова для поиска в БД)
  const LIST = [
    { t: "ВВГнг-LS 3х1.5", kws: ["ввг", "3", "1.5"] },
    { t: "ВВГнг-LS 3х2.5", kws: ["ввг", "3", "2.5"] },
    { t: "ВВГнг-LS 3х4", kws: ["ввг", "3", "4"] },
    { t: "ВВГнг-LS 3х6", kws: ["ввг", "3", "6"] },
    { t: "ВВГнг-LS 3х10", kws: ["ввг", "3", "10"] },
    { t: "ВВГнг-LS 3х16", kws: ["ввг", "3", "16"] },
    { t: "ВВГнг-LS 2х2.5", kws: ["ввг", "2", "2.5"] },
    { t: "ВВГнг-LS 5х2.5", kws: ["ввг", "5", "2.5"] },
    { t: "ВВГнг-LS 5х4", kws: ["ввг", "5", "4"] },
    { t: "ВВГнг-LS 5х6", kws: ["ввг", "5", "6"] },
    { t: "NYM 3х1.5", kws: ["nym", "3", "1.5"] },
    { t: "NYM 3х2.5", kws: ["nym", "3", "2.5"] },
    { t: "ПВС 3х1.5", kws: ["пвс", "3", "1.5"] },
    { t: "ПВС 3х2.5", kws: ["пвс", "3", "2.5"] }
  ];

  // автоподстановка по номиналу автомата (по сечению), правится пользователем
  const NOM_MAP = {
    C6: "ВВГнг-LS 3х1.5", C10: "ВВГнг-LS 3х1.5", C16: "ВВГнг-LS 3х2.5",
    C20: "ВВГнг-LS 3х2.5", C25: "ВВГнг-LS 3х4", C32: "ВВГнг-LS 3х6",
    C40: "ВВГнг-LS 3х10", C50: "ВВГнг-LS 3х10", C63: "ВВГнг-LS 3х16"
  };

  function clean(nom) { return String(nom || "").toUpperCase().replace(/\s+/g, ""); }
  function defaultValueFor(nom) {
    const key = clean(nom).replace(/[^C0-9]/g, "");
    const t = NOM_MAP[key] || "ВВГнг-LS 3х2.5";
    return "fix:" + t;
  }

  function looksLikeCable(name) {
    const n = String(name || "").toLowerCase();
    return /(ввг|nym|пвс|кабель|ппг|пунп|кг\b|шввп|ввгнг)/.test(n) && /\d+\s*[хx*]\s*\d/.test(n);
  }
  function dbCables() {
    try {
      const G = window.EPDatabaseV27;
      if (!G || !G.getRows) return [];
      const base = G.getActiveBase ? G.getActiveBase() : null;
      const rows = (G.getRows(base, "material") || []).filter(r => r && (r.active !== false) && looksLikeCable(r.name));
      return rows.map(r => ({ id: r.id, name: r.name, price: Number(r.price) || 0 }));
    } catch (e) { return []; }
  }

  function all() {
    const out = [];
    dbCables().forEach(c => out.push({ value: "db:" + c.id, label: c.name + (c.price ? " — " + c.price + " ₽" : ""), price: c.price }));
    LIST.forEach(c => out.push({ value: "fix:" + c.t, label: c.t, price: 0 }));
    return out;
  }

  function findFix(t) { return LIST.find(c => c.t === t); }
  const norm = s => String(s || "").toLowerCase().replace(/ё/g, "е").replace(/,/g, ".").replace(/\s+/g, "").replace(/[х*]/g, "x");

  function matchDbCable(typeStr, rule) {
    const tn = norm(typeStr);
    const mm = tn.match(/(\d+)x(\d+(?:\.\d+)?)/);
    if (!mm) return null;
    const cores = mm[1], sect = parseFloat(mm[2]);
    const famRaw = (tn.match(/^[a-zа-я]+/) || [""])[0];
    const fam = famRaw.indexOf("ввг") >= 0 ? "ввг" : famRaw.indexOf("nym") >= 0 ? "nym" : famRaw.indexOf("пвс") >= 0 ? "пвс" : famRaw.slice(0, 3);
    const cand = dbCables().filter(c => {
      const cn = norm(c.name);
      const cm = cn.match(/(\d+)x(\d+(?:\.\d+)?)/);
      if (!cm) return false;
      const secOK = cm[1] === cores && parseFloat(cm[2]) === sect;
      const famOK = !fam || cn.indexOf(fam) >= 0;
      return secOK && famOK;
    });
    if (!cand.length) return null;
    cand.sort((a, b) => rule === "max" ? b.price - a.price : a.price - b.price);
    return cand[0];
  }

  function resolveByValue(value, rule) {
    value = String(value || "");
    rule = rule === "max" ? "max" : "min";
    if (value.indexOf("db:") === 0) {
      const id = value.slice(3);
      const c = dbCables().find(x => String(x.id) === id);
      if (c) return { label: c.name, name: c.name, price: c.price, found: true };
      return { label: "Кабель", name: "", price: 0, found: false };
    }
    const t = value.indexOf("fix:") === 0 ? value.slice(4) : value;
    const hit = matchDbCable(t, rule);
    if (hit) return { label: t, name: hit.name, price: hit.price, found: true };
    return { label: t, name: "", price: 0, found: false };
  }

  function shortLabel(value, len) {
    if (!value) return "";
    let t = "";
    if (String(value).indexOf("db:") === 0) { const r = resolveByValue(value); t = r.name || r.label || "кабель"; }
    else { t = String(value).indexOf("fix:") === 0 ? String(value).slice(4) : String(value); }
    t = t.replace(/^\s*кабель\s*/i, "").replace(/нг\(?а?\)?\s*-?\s*ls/ig, "").replace(/\bгост\b.*$/i, "").replace(/\s{2,}/g, " ").trim();
    const L = Number(len) || 0;
    return L > 0 ? (t + " · " + L + "м") : t;
  }

  window.EPCableV28 = { LIST, NOM_MAP, defaultValueFor, dbCables, all, resolveByValue, shortLabel };
})();
