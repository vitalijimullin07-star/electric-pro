/* Shield Configurator V28.2 — стиль в духе приложения (тёмное стекло, зелёные акценты) */
#ep-shield-v28-root { display:block; }

.shv28 { display:flex; flex-direction:column; gap:12px; padding-bottom:24px; }

.shv28-card {
  background: rgba(248,250,252,.97);
  color:#0f172a;
  border-radius:18px;
  padding:14px;
  box-shadow:0 10px 28px rgba(0,0,0,.18);
}
.shv28-card h3 { margin:0 0 8px; font:900 16px/1.2 system-ui; letter-spacing:-.01em; }
.shv28-note { color:#64748b; font:700 12px/1.3 system-ui; margin-bottom:10px; }

/* шаблоны */
.shv28-tpl { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
.shv28-tpl-btn {
  border:1px solid rgba(15,23,42,.12); background:#fff; color:#0f172a;
  border-radius:12px; padding:11px 6px; font:800 13px/1.1 system-ui;
}
.shv28-tpl-btn.active { background:#dcfce7; border-color:#22c55e; color:#14532d; }

/* помещения */
.shv28-rooms { display:flex; flex-direction:column; gap:8px; }
.shv28-room { display:flex; align-items:center; gap:10px; }
.shv28-room-ic { font-size:18px; flex:0 0 auto; }
.shv28-room-lb { flex:1; min-width:0; font:800 14px/1.2 system-ui; }
.shv28-stepper { display:grid; grid-template-columns:34px 52px 34px; gap:6px; flex:0 0 auto; }
.shv28-stepper button {
  height:34px; border:0; border-radius:10px; background:#020617; color:#fff;
  font:900 18px/1 system-ui;
}
.shv28-stepper input {
  height:34px; width:100%; text-align:center; border:1px solid rgba(15,23,42,.14);
  border-radius:10px; background:rgba(226,232,240,.7); color:#0f172a;
  font:900 15px/1 system-ui; outline:none; -moz-appearance:textfield;
}
.shv28-stepper input::-webkit-outer-spin-button,
.shv28-stepper input::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
.shv28-stepper input:focus { background:#fff; border-color:#22c55e; }

/* отдельные линии */
.shv28-lines { display:flex; flex-direction:column; gap:7px; }
.shv28-line {
  display:flex; align-items:center; gap:10px; width:100%; text-align:left;
  border:1px solid rgba(15,23,42,.10); background:#fff; color:#0f172a;
  border-radius:12px; padding:11px 12px; font:800 14px/1.2 system-ui;
}
.shv28-line-lb { flex:1; min-width:0; }
.shv28-nom {
  flex:0 0 auto; background:rgba(226,232,240,.85); color:#334155;
  border-radius:999px; padding:2px 9px; font:900 12px/1.3 system-ui;
}
.shv28-tick { flex:0 0 18px; width:18px; text-align:center; color:#22c55e; font:900 16px/1 system-ui; }
.shv28-line.on { background:#dcfce7; border-color:#22c55e; }
.shv28-line.on .shv28-nom { background:#fff; color:#14532d; }

/* опции */
.shv28-opts { display:flex; flex-direction:column; gap:7px; }
.shv28-opt {
  display:flex; align-items:center; justify-content:space-between; gap:10px; width:100%;
  border:1px solid rgba(15,23,42,.10); background:#fff; color:#0f172a;
  border-radius:12px; padding:11px 12px; font:800 14px/1.2 system-ui; text-align:left;
}
.shv28-opt b { font:900 12px/1.3 system-ui; color:#94a3b8; }
.shv28-opt.on { background:#dcfce7; border-color:#22c55e; }
.shv28-opt.on b { color:#14532d; }

/* корпус */
.shv28-grid2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.shv28-grid2 label { display:flex; flex-direction:column; gap:5px; font:800 12px/1.2 system-ui; color:#475569; }
.shv28-grid2 select {
  height:40px; border:1px solid rgba(15,23,42,.14); border-radius:10px;
  background:#fff; color:#0f172a; font:800 14px/1 system-ui; padding:0 8px;
}
.shv28-sizemode {
  margin-top:10px; width:100%; display:flex; align-items:center; justify-content:space-between;
  border:1px solid rgba(15,23,42,.10); background:#fff; color:#0f172a;
  border-radius:12px; padding:11px 12px; font:800 13px/1.2 system-ui; text-align:left;
}
.shv28-sizemode b { font:900 12px/1.3 system-ui; color:#94a3b8; }
.shv28-sizemode.on { background:#dcfce7; border-color:#22c55e; }
.shv28-sizemode.on b { color:#14532d; }

/* сводка */
.shv28-summary {
  display:grid; grid-template-columns:repeat(3,1fr); gap:8px;
  background:rgba(2,20,21,.5); border:1px solid rgba(34,197,94,.25);
  border-radius:16px; padding:12px;
}
.shv28-summary div { display:flex; flex-direction:column; gap:3px; text-align:center; }
.shv28-summary span { color:#94a3b8; font:700 10px/1.2 system-ui; }
.shv28-summary b { color:#e2e8f0; font:900 16px/1 system-ui; }

/* кнопка далее */
.shv28-next {
  width:100%; border:0; border-radius:16px; padding:14px;
  background:linear-gradient(135deg,#16a34a,#22c55e); color:#fff;
  font:900 16px/1.1 system-ui; display:flex; flex-direction:column; align-items:center; gap:2px;
}
.shv28-next small { font:700 11px/1 system-ui; opacity:.85; }

/* ===== V28.2.1 дополнения ===== */
/* сворачиваемые карточки настроек */
.shv28-foldcard { background:rgba(248,250,252,.97); border-radius:18px; box-shadow:0 10px 28px rgba(0,0,0,.18); overflow:hidden; }
.shv28-foldcard > summary { list-style:none; cursor:pointer; display:flex; align-items:center; gap:12px; padding:14px; }
.shv28-foldcard > summary::-webkit-details-marker { display:none; }
.shv28-fi { flex:0 0 auto; width:40px; height:40px; border-radius:12px; background:#eef2ff; display:flex; align-items:center; justify-content:center; font-size:20px; }
.shv28-ftx { flex:1; min-width:0; display:flex; flex-direction:column; gap:2px; }
.shv28-ftx b { font:900 15px/1.2 system-ui; color:#0f172a; }
.shv28-ftx i { font-style:normal; font:700 11px/1.3 system-ui; color:#64748b; }
.shv28-arrow { flex:0 0 auto; color:#94a3b8; font:900 16px/1 system-ui; transition:transform .2s; }
.shv28-foldcard[open] .shv28-arrow { transform:rotate(180deg); }
.shv28-foldbody { padding:0 14px 14px; }
.shv28-sublabel { font:800 12px/1.2 system-ui; color:#475569; margin:10px 0 7px; }

/* профиль качества */
.shv28-prof { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
.shv28-prof-btn { border:1px solid rgba(15,23,42,.12); background:#fff; color:#0f172a; border-radius:12px; padding:11px 6px; font:800 13px/1.1 system-ui; }
.shv28-prof-btn.active { background:#e0e7ff; border-color:#4f46e5; color:#3730a3; }

.shv28-wide { width:100%; height:42px; border:1px solid rgba(15,23,42,.14); border-radius:10px; background:#fff; color:#0f172a; font:800 14px/1 system-ui; padding:0 10px; }

/* подсказки помещений */
.shv28-room-tx { flex:1; min-width:0; display:flex; flex-direction:column; gap:2px; }
.shv28-room-tx b { font:800 14px/1.2 system-ui; color:#0f172a; }
.shv28-room-tx i { font-style:normal; font:600 10px/1.25 system-ui; color:#64748b; }

/* черновик */
.shv28-draft-empty { color:#94a3b8; font:700 13px/1.3 system-ui; text-align:center; padding:14px; background:#f1f5f9; border-radius:12px; }
.shv28-draft-note { font:800 12px/1.3 system-ui; color:#475569; margin-bottom:8px; }
.shv28-draft-note b { color:#16a34a; }
.shv28-draft-list { display:flex; flex-direction:column; gap:5px; max-height:320px; overflow:auto; }
.shv28-draft-row { display:flex; align-items:center; gap:8px; background:#fff; border:1px solid rgba(15,23,42,.08); border-radius:10px; padding:8px 10px; font:700 12px/1.2 system-ui; }
.shv28-draft-row .n { flex:0 0 22px; width:22px; height:22px; border-radius:6px; background:#eef2ff; color:#4f46e5; display:flex; align-items:center; justify-content:center; font:900 11px/1 system-ui; }
.shv28-draft-row .nm { flex:1; min-width:0; color:#0f172a; }
.shv28-draft-row .nom { flex:0 0 auto; background:#dcfce7; color:#14532d; border-radius:999px; padding:2px 8px; font:900 11px/1.3 system-ui; }
.shv28-draft-row .note { flex:0 0 auto; color:#94a3b8; font:600 10px/1.2 system-ui; }
.shv28-draft-hint { margin-top:10px; font:600 11px/1.3 system-ui; color:#64748b; }

/* панель действий — компактная, в обычном потоке (не прилипает, не наезжает) */
.shv28-actions { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:4px; padding-bottom:16px; }
.shv28-btn { border:0; border-radius:12px; padding:11px 4px; font:800 13px/1.1 system-ui; color:#fff; white-space:nowrap; box-shadow:0 6px 16px rgba(0,0,0,.18); }
.shv28-btn.gen { background:linear-gradient(135deg,#16a34a,#22c55e); }
.shv28-btn.add { background:linear-gradient(135deg,#d97706,#f59e0b); }
.shv28-btn.clr { background:linear-gradient(135deg,#dc2626,#ef4444); }

/* строки черновика с подбором по БД (V28.3) */
.shv28-draft-row2 { background:#fff; border:1px solid rgba(15,23,42,.08); border-radius:10px; padding:8px 10px; }
.shv28-draft-row2 .r1 { display:flex; align-items:center; gap:8px; }
.shv28-draft-row2 .r1 .n { flex:0 0 22px; width:22px; height:22px; border-radius:6px; background:#eef2ff; color:#4f46e5; display:flex; align-items:center; justify-content:center; font:900 11px/1 system-ui; }
.shv28-draft-row2 .r1 .nm { flex:1; min-width:0; color:#0f172a; font:800 12px/1.2 system-ui; }
.shv28-draft-row2 .r1 .nom { flex:0 0 auto; background:#dcfce7; color:#14532d; border-radius:999px; padding:2px 8px; font:900 11px/1.3 system-ui; }
.shv28-draft-db { margin-top:5px; font:700 11px/1.3 system-ui; }
.shv28-draft-db.ok { color:#15803d; } .shv28-draft-db.ok b { color:#0f172a; } .shv28-draft-db.ok i { color:#94a3b8; font-style:normal; }
.shv28-draft-db.no { color:#b45309; }
.shv28-draft-note2 { margin-top:3px; color:#94a3b8; font:600 10px/1.2 system-ui; }

/* результат распознавания параметров БД */
.shv28-recognize-res { margin-top:10px; font:700 11px/1.4 system-ui; color:#15803d; }
.shv28-recognize-res:empty { display:none; }

/* замена позиции: список альтернатив */
.shv28-draft-db.ok[data-alts] { cursor:pointer; }
.shv28-alts { margin-top:6px; display:flex; flex-direction:column; gap:5px; }
.shv28-alt { display:flex; align-items:center; justify-content:space-between; gap:8px; width:100%; text-align:left; border:1px solid rgba(15,23,42,.12); background:#f8fafc; color:#0f172a; border-radius:9px; padding:8px 10px; font:700 11px/1.25 system-ui; }
.shv28-alt span { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.shv28-alt b { flex:0 0 auto; color:#16a34a; font:900 12px/1 system-ui; }
.shv28-alt.cur { background:#dcfce7; border-color:#22c55e; }

/* группы защиты в черновике (V28.3b-1) */
.shv28-group { border:1px solid rgba(15,23,42,.12); border-radius:12px; overflow:hidden; margin-bottom:10px; background:#fff; }
.shv28-group-head { display:flex; align-items:center; gap:8px; padding:9px 11px; background:#eef2ff; }
.shv28-group-head .gt { flex:1; min-width:0; font:900 13px/1.2 system-ui; color:#312e81; }
.shv28-group-head .gl { flex:0 0 auto; background:#c7d2fe; color:#312e81; border-radius:999px; padding:2px 8px; font:900 11px/1.2 system-ui; }
.shv28-group-head .gc { flex:0 0 auto; color:#64748b; font:800 11px/1.2 system-ui; }
.shv28-prot { padding:9px 11px; font:800 12px/1.3 system-ui; border-bottom:1px solid rgba(15,23,42,.08); }
.shv28-prot.ok { color:#15803d; background:#f0fdf4; cursor:pointer; } .shv28-prot.ok b { color:#0f172a; } .shv28-prot.ok i { font-style:normal; color:#94a3b8; }
.shv28-prot.no { color:#b45309; background:#fffbeb; }
.shv28-group-lines { padding:8px 10px; display:flex; flex-direction:column; gap:6px; }

/* расходка и шины (V28.3b-3) */
.shv28-cons { border:1px solid rgba(15,23,42,.12); border-radius:12px; overflow:hidden; margin-bottom:10px; background:#fff; }
.shv28-cons-head { padding:9px 11px; background:#fef3c7; color:#78350f; font:900 12px/1.3 system-ui; }
.shv28-cons-head b { color:#0f172a; }
.shv28-cons-row { display:flex; align-items:center; gap:8px; padding:7px 11px; border-top:1px solid rgba(15,23,42,.06); font:700 12px/1.2 system-ui; }
.shv28-cons-row .cl { flex:1; min-width:0; color:#0f172a; }
.shv28-cons-row .cq { flex:0 0 auto; color:#64748b; font:800 11px/1; }
.shv28-cons-row .cp { flex:0 0 auto; color:#16a34a; font:900 12px/1; }
.shv28-cons-row .cp.no { color:#b45309; font:700 11px/1; }
.shv28-cons-note { padding:7px 11px; border-top:1px solid rgba(15,23,42,.06); color:#64748b; font:600 10px/1.3 system-ui; }
.shv28-grand { background:rgba(2,20,21,.9); color:#e2e8f0; border-radius:12px; padding:12px; text-align:center; font:800 13px/1.3 system-ui; margin-bottom:10px; }
.shv28-grand b { color:#4ade80; font:900 16px/1 system-ui; }

/* краткий итог аппаратов (V28.3b-3.1) */
.shv28-agg { border:1px solid rgba(15,23,42,.12); border-radius:12px; overflow:hidden; margin-bottom:10px; background:#fff; }
.shv28-agg-head { padding:9px 11px; background:#dbeafe; color:#1e3a8a; font:900 12px/1.3 system-ui; }
.shv28-agg-row { display:flex; align-items:center; gap:8px; padding:7px 11px; border-top:1px solid rgba(15,23,42,.06); font:700 12px/1.2 system-ui; }
.shv28-agg-row span:first-child { flex:1; min-width:0; color:#0f172a; }
.shv28-agg-row .q { flex:0 0 auto; color:#64748b; font:800 11px/1; }
.shv28-agg-row .p { flex:0 0 auto; color:#16a34a; font:900 12px/1; }

/* работа, ручной ввод, итоги (V28.3b-4) */
.shv28-cons-head.work { background:#e0e7ff; color:#3730a3; }
.shv28-manual { border:1px solid #f59e0b; background:#fffbeb; color:#b45309; border-radius:8px; padding:4px 9px; font:800 10px/1 system-ui; }
.shv28-cons-row .cp i { font-style:normal; color:#94a3b8; font-weight:600; }
.shv28-totals { display:flex; flex-direction:column; gap:6px; background:#fff; border:1px solid rgba(15,23,42,.12); border-radius:12px; padding:11px; margin-bottom:10px; }
.shv28-totals > div { display:flex; align-items:center; justify-content:space-between; font:800 13px/1.2 system-ui; color:#475569; }
.shv28-totals > div b { color:#0f172a; font:900 14px/1 system-ui; }
.shv28-totals .grand { border-top:1px dashed rgba(15,23,42,.18); padding-top:8px; margin-top:2px; }
.shv28-totals .grand span { color:#0f172a; } .shv28-totals .grand b { color:#16a34a; font:900 18px/1 system-ui; }

/* раскладка по DIN-рейкам (V28.4) */
.shv28-rail { margin-bottom:8px; }
.shv28-rail-no { font:800 10px/1.2 system-ui; color:#94a3b8; margin-bottom:3px; }
.shv28-rail-grid { display:grid; grid-template-columns:repeat(12,1fr); gap:3px; }
.shv28-cell { min-height:46px; border-radius:6px; display:flex; align-items:center; justify-content:center; padding:2px; text-align:center; border:1px solid rgba(15,23,42,.12); overflow:hidden; }
.shv28-cell span { font:800 9px/1.05 system-ui; color:#0f172a; word-break:break-word; }
.shv28-cell.input { background:#fee2e2; border-color:#ef4444; } .shv28-cell.input span { color:#991b1b; }
.shv28-cell.rcd { background:#dcfce7; border-color:#22c55e; } .shv28-cell.rcd span { color:#166534; }
.shv28-cell.avt { background:#e0f2fe; border-color:#38bdf8; } .shv28-cell.avt span { color:#075985; }
.shv28-cell.extra { background:#fef9c3; border-color:#eab308; } .shv28-cell.extra span { color:#854d0e; }
.shv28-cell.gap { background:repeating-linear-gradient(45deg,#f1f5f9,#f1f5f9 5px,#e2e8f0 5px,#e2e8f0 10px); border:1px dashed rgba(15,23,42,.12); }

/* раскладка: вход + полноэкранный оверлей (V28.4-2) */
.shv28-railentry { padding:0; }
.shv28-railbtn { display:flex; align-items:center; justify-content:space-between; width:100%; background:transparent; border:0; padding:16px; font:900 14px/1.2 system-ui; color:#0f172a; }
.shv28-railbtn b { color:#0ea5e9; font:800 12px/1 system-ui; }
.shv28-cell { flex-direction:column; gap:1px; }
.shv28-cell .des { font:900 8px/1 system-ui; color:#475569; opacity:.8; }
.shv28-cell .nm { font:900 10px/1.05 system-ui; }
.shv28-cell .amp { font:700 8px/1 system-ui; opacity:.75; }
.shv28-cell.sel { outline:3px solid #0ea5e9; outline-offset:-1px; }
.shv28-overlay { position:fixed; inset:0; z-index:9999; background:#0b1220; display:flex; flex-direction:column; }
.shv28-ov-head { display:flex; align-items:center; gap:10px; padding:14px 16px; background:#111827; color:#fff; }
.shv28-ov-head b { font:900 15px/1.2 system-ui; }
.shv28-ov-head .ov-sub { flex:1; color:#94a3b8; font:700 11px/1.2 system-ui; }
.rc-x { background:#1f2937; color:#fff; border:0; border-radius:8px; width:34px; height:34px; font:900 14px/1 system-ui; }
.shv28-ov-body { flex:1; overflow:auto; padding:16px; background:#0b1220; }
.shv28-ov-body .shv28-rail-no { color:#64748b; }
.shv28-ov-body .shv28-cell { min-height:54px; }
.shv28-ov-foot { display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:6px; padding:12px 16px; background:#111827; }
.shv28-ov-foot .shv28-btn { padding:12px 6px; font:800 12px/1 system-ui; }
.shv28-ov-legend { display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 6px; }
.shv28-ov-legend .lg { font:800 10px/1 system-ui; color:#cbd5e1; padding:5px 9px; border-radius:999px; border:1px solid rgba(255,255,255,.15); }
.shv28-ov-legend .lg.input { background:#7f1d1d; } .shv28-ov-legend .lg.rcd { background:#14532d; } .shv28-ov-legend .lg.avt { background:#075985; } .shv28-ov-legend .lg.extra { background:#854d0e; } .shv28-ov-legend .lg.gap { background:#334155; }
.shv28-railcard { background:#fff; border-radius:12px; padding:12px; margin-top:12px; }
.shv28-railcard .rc-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:8px; }
.shv28-railcard .rc-head b { font:900 14px/1.2 system-ui; color:#0f172a; }
.shv28-railcard .rc-head .rc-x { background:#e2e8f0; color:#0f172a; }
.shv28-railcard .rc-row { display:flex; justify-content:space-between; gap:10px; padding:5px 0; border-top:1px solid rgba(15,23,42,.06); font:700 12px/1.3 system-ui; color:#64748b; }
.shv28-railcard .rc-row b { color:#0f172a; text-align:right; }

/* сворачивание группы в черновике (V28.4-3) */
.shv28-group-head { cursor:pointer; user-select:none; }
.shv28-group-head .gx { flex:0 0 auto; width:24px; height:24px; border-radius:7px; background:#c7d2fe; color:#312e81; display:flex; align-items:center; justify-content:center; font:900 12px/1 system-ui; margin-left:2px; }

/* переключатель видов + однолинейная схема (V28.4-4) */
.shv28-ov-tabs { display:flex; gap:6px; padding:8px 16px; background:#111827; }
.shv28-ov-tabs button { flex:1; border:0; border-radius:9px; padding:9px; background:#1f2937; color:#cbd5e1; font:800 12px/1 system-ui; }
.shv28-ov-tabs button.act { background:#0ea5e9; color:#fff; }
.sch { color:#e2e8f0; }
.sch-node { border-radius:10px; padding:10px 12px; font:800 12px/1.25 system-ui; text-align:center; }
.sch-node.input { background:#7f1d1d; color:#fee2e2; border:1px solid #ef4444; }
.sch-extras { display:flex; flex-wrap:wrap; gap:6px; justify-content:center; margin:8px 0; }
.sch-extras span { background:#854d0e; color:#fef3c7; border-radius:999px; padding:4px 10px; font:800 10px/1 system-ui; }
.sch-bus { margin:10px 0; text-align:center; color:#94a3b8; font:800 10px/1 system-ui; border-top:2px dashed #334155; border-bottom:2px dashed #334155; padding:6px 0; }
.sch-groups { display:flex; flex-direction:column; gap:12px; }
.sch-branch { position:relative; padding-left:14px; border-left:2px solid #334155; }
.sch-node.rcd { background:#14532d; color:#dcfce7; border:1px solid #22c55e; }
.sch-node.dif { background:#0c4a6e; color:#e0f2fe; border:1px solid #38bdf8; }
.sch-lines { display:flex; flex-direction:column; gap:5px; margin-top:6px; padding-left:10px; }
.sch-line { display:flex; align-items:center; gap:8px; background:#0f172a; border:1px solid #1e293b; border-radius:8px; padding:7px 9px; }
.sch-line .d { flex:0 0 auto; background:#1e3a8a; color:#dbeafe; border-radius:6px; padding:2px 6px; font:900 9px/1.2 system-ui; }
.sch-line .nom { flex:0 0 auto; background:#075985; color:#e0f2fe; border-radius:6px; padding:2px 6px; font:900 10px/1 system-ui; }
.sch-line .nm { flex:1; min-width:0; color:#cbd5e1; font:700 11px/1.2 system-ui; }

/* SVG-схема (V28.4-5): белый холст внутри тёмного оверлея */
.shv28-scheme-wrap { background:#fff; border-radius:12px; padding:8px; overflow:auto; max-width:100%; }
#shv28-scheme-svg { display:block; background:#fff; }
#shv28-scheme-svg .ep-sd { stroke:#111; stroke-width:2; fill:none; }
#shv28-scheme-svg .ep-id { font:800 14px/1 system-ui; fill:#111; text-anchor:start; }
#shv28-scheme-svg .ep-lbl { font:600 12px/1 system-ui; fill:#444; text-anchor:start; }
#shv28-scheme-svg .ep-rt { font:800 13px/1 system-ui; fill:#0056b3; text-anchor:start; }
#shv28-scheme-svg .ep-bd { fill:#fff; }
#shv28-scheme-svg text { pointer-events:none; }

/* "не найдено" в кратко (V28.9) */
.shv28-agg-row .p.no { color:#b45309; font:700 11px/1 system-ui; }

/* бейдж бренда выбранной позиции (V28.10) */
.shv28-brand { display:inline-block; background:#1e3a8a; color:#dbeafe; border-radius:5px; padding:1px 6px; font:800 9px/1.4 system-ui; vertical-align:middle; }

/* редактор шаблонов (V28.12) */
.shv28-tpl-save { width:100%; margin-top:10px; padding:11px; border:1px dashed #6366f1; border-radius:10px; background:#eef2ff; color:#4338ca; font:800 13px/1 system-ui; cursor:pointer; }
.shv28-tpl-save:active { background:#e0e7ff; }
.shv28-tpl-btn { position:relative; }
.shv28-tpl-del { margin-left:7px; display:inline-flex; width:16px; height:16px; align-items:center; justify-content:center; border-radius:50%; background:rgba(239,68,68,.15); color:#dc2626; font-size:9px; font-style:normal; }
.shv28-tpl-empty { color:#94a3b8; font:600 12px/1.4 system-ui; padding:4px 2px; display:block; }
