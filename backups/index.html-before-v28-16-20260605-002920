  <section id="diagnosticsModal" class="modal hidden">
    <div class="modal-card glass">
      <div class="modal-head">
        <h2>Диагностика</h2>
        <button id="closeDiagnosticsBtn" class="icon-btn ep-clickable">×</button>
      </div>

      <div class="smart-status-grid">
        <div class="smart-status-card"><span>Firebase</span><strong id="smartFirebaseText">проверка</strong></div>
        <div class="smart-status-card"><span>Кэш</span><strong id="smartCacheText">готов</strong></div>
        <div class="smart-status-card"><span>Синхронизация</span><strong id="smartSyncText">ожидание</strong></div>
      </div>

      <pre id="diagnosticsText" class="diagnostics-box"></pre>

      <div class="modal-actions">
        <button id="copyDiagnosticsBtn" class="btn btn-primary ep-clickable">Скопировать ошибку / статус</button>
        <button id="clearDiagnosticsBtn" class="btn btn-ghost ep-clickable">Очистить</button>
        <button id="hardReloadBtn" class="btn btn-ghost ep-clickable">Обновить без кэша</button>
      </div>
    </div>
  </section>

  <section id="visualPanel" class="modal hidden">
    <div class="modal-card glass visual-card">
      <div class="modal-head">
        <h2>Настройка визуала</h2>
        <button id="closeVisualBtn" class="icon-btn ep-clickable">×</button>
      </div>

      <div class="visual-section">
        <div class="visual-section-title">Готовые стили</div>
        <div class="theme-grid" id="themeGrid"></div>
      </div>

      <div class="visual-section">
        <div class="visual-section-title">Быстрые профили</div>
        <div class="quick-profile-grid">
          <button data-profile="object" class="ep-clickable">На объекте</button>
          <button data-profile="night" class="ep-clickable">Ночь</button>
          <button data-profile="day" class="ep-clickable">День</button>
          <button data-profile="battery" class="ep-clickable">Экономия</button>
          <button data-profile="premium" class="ep-clickable">Премиум</button>
          <button data-profile="readable" class="ep-clickable">Читаемость</button>
        </div>
      </div>

      <div class="visual-section">
        <div class="visual-section-title">Режим</div>
        <div class="segmented-control visual-mode-control">
          <button type="button" data-visual-mode="day" class="ep-clickable">День</button>
          <button type="button" data-visual-mode="night" class="ep-clickable">Ночь</button>
          <button type="button" data-visual-mode="auto" class="ep-clickable">Авто</button>
        </div>
      </div>

      <div class="visual-section">
        <button id="toggleAdvancedVisualBtn" class="btn btn-ghost btn-wide ep-clickable" type="button">Расширенная настройка</button>
        <div id="advancedVisualPanel" class="advanced-visual-panel">
          <div class="settings-grid">
            <label>Акцентный цвет<input id="accentColorInput" type="color" /></label>
            <label>Цвет кнопок<input id="buttonColorInput" type="color" /></label>
            <label>Цвет текста<input id="textColorInput" type="color" /></label>
            <label>Цвет вторичного текста<input id="mutedColorInput" type="color" /></label>
            <label>Цвет фона<input id="backgroundColorInput" type="color" /></label>
            <label>Цвет карточек<input id="cardColorInput" type="color" /></label>
            <label>Прозрачность карточек<input id="glassOpacityInput" type="range" min="0.35" max="0.95" step="0.01" /></label>
            <label>Прозрачность кнопок<input id="buttonOpacityInput" type="range" min="0.35" max="1" step="0.01" /></label>
            <label>Скругление карточек<input id="radiusInput" type="range" min="8" max="36" step="1" /></label>
            <label>Скругление кнопок<input id="buttonRadiusInput" type="range" min="6" max="36" step="1" /></label>
            <label>Размытие стекла<input id="blurInput" type="range" min="4" max="28" step="1" /></label>
            <label>Размер текста<input id="fontScaleInput" type="range" min="0.88" max="1.2" step="0.01" /></label>
            <label>Плотность интерфейса<select id="densityInput"><option value="compact">Компактно</option><option value="normal">Обычно</option><option value="large">Крупнее</option></select></label>
            <label>Форма кнопок<select id="buttonShapeInput"><option value="soft">Мягкие</option><option value="round">Круглые</option><option value="square">Почти квадратные</option><option value="pill">Пилюли</option><option value="minimal">Минималистичные</option></select></label>
            <label>Выбор фона<select id="backgroundStyleInput"><option value="glass">Стекло базовый</option><option value="blueprint">Чертёж</option><option value="gradient">Градиент</option><option value="dark">Тёмный</option><option value="light">Светлый</option><option value="minimal">Минимальный</option><option value="solid">Свой цвет</option></select></label>
          </div>
        </div>
      </div>

      <div class="visual-section">
        <div class="visual-section-title">Анимации</div>
        <div class="settings-grid">
          <label>Стиль анимации<select id="animationStyleInput"><option value="glass">Стекло</option><option value="soft">Мягко</option><option value="fast">Быстро</option><option value="spring">Пружина</option><option value="premium">Премиум</option><option value="minimal">Минимум</option><option value="off">Отключено</option></select></label>
          <label>Скорость анимации<input id="animationSpeedInput" type="range" min="0.55" max="1.75" step="0.05" /></label>
          <button id="reduceMotionInput" class="switch-btn ep-clickable" type="button" data-toggle-key="reduceMotion">
            <span>Экономить анимации</span><b></b>
          </button>
          <button id="electricPulseInput" class="switch-btn ep-clickable" type="button" data-toggle-key="electricPulse">
            <span>Электрический импульс кнопок</span><b></b>
          </button>
        </div>
      </div>

      <div class="visual-section">
        <div class="visual-section-title">Звук и вибро</div>
        <div class="settings-grid">
          <button id="soundEnabledInput" class="switch-btn ep-clickable" type="button" data-toggle-key="soundEnabled">
            <span>Звуки интерфейса</span><b></b>
          </button>
          <button id="hapticEnabledInput" class="switch-btn ep-clickable" type="button" data-toggle-key="hapticEnabled">
            <span>Виброотклик</span><b></b>
          </button>
          <label>Громкость звуков<input id="soundVolumeInput" type="range" min="0" max="1" step="0.05" /></label>
          <label>Стиль звука<select id="soundStyleInput">
            <option value="soft">Мягкий</option>
            <option value="soft2">Мягкий 2</option>
            <option value="soft3">Мягкий 3</option>
            <option value="air">Воздушный</option>
            <option value="glass">Стекло</option>
            <option value="warm">Тёплый</option>
            <option value="short">Короткий</option>
            <option value="deep">Глухой</option>
            <option value="electric-soft">Электро мягкий</option>
            <option value="none">Без звука</option>
          </select></label>
          <button id="testSoundBtn" class="btn btn-ghost btn-wide ep-clickable" type="button">Проверить звук</button>
        </div>
      </div>

      <div class="grid grid-2">
        <button id="resetVisualBtn" class="btn btn-ghost btn-wide ep-clickable">Сбросить визуал</button>
        <button id="baseVisualBtn" class="btn btn-primary btn-wide ep-clickable">Вернуть базовый стиль</button>
      </div>
    </div>
  </section>
