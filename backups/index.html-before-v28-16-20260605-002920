      </div>

      <button id="firebaseStatusBtn" class="status-btn ep-clickable" aria-label="Статус Firebase">
        <span id="firebaseDot" class="status-dot status-wait"></span>
      </button>
    </header>

    <aside id="sideMenu" class="side-menu glass">
      <div class="side-head">
        <div class="avatar">⚡</div>
